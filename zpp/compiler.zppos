./ZPP@

// ZPP Self-Hosting Compiler

fun& compile(source: str) -> ptr<u8> =========
    osprint''Compiling ZPP source...''
    
    // Lexical analysis
    let tokens = lex(source)
    osprint''  Tokens: {len(tokens)}''
    
    // Parsing
    let ast = parse(tokens)
    osprint''  AST nodes: {len(ast)}''
    
    // Code generation
    let binary = generate_x86_64(ast)
    osprint''  Binary size: {len(binary)} bytes''
    
    return binary
=========

fun& lex(source: str) -> list<str> =========
    let tokens: list<str> = []
    let i = 0
    
    while i < len(source) =========
        let c = source[i]
        
        if c == ' ' or c == '\t' or c == '\n' =========
            i = i + 1
            continue
        ========= else if c == '/' and source[i+1] == '/' =========
            // Skip comment until \\
            i = i + 2
            while i < len(source) and !(source[i] == '\\' and source[i-1] == '\\') =========
                i = i + 1
            =========
            i = i + 1
        ========= else =========
            // TODO: Full lexer
            tokens.append("token")
            i = i + 1
        =========
    =========
    
    return tokens
=========
